{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "db-connector",
  "name": "DB Connector",
  "version": "0.1.0",
  "description": "Save database connections, test them and run read-only queries from a sidebar panel. Passwords stay in Orca's encrypted secrets store.",
  "author": {
    "name": "maximinhan",
    "url": "https://github.com/maximinhan"
  },
  "repository": "https://github.com/maximinhan/orca-db-connector",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.247"
  },
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "db-connector",
        "title": "DB Connector",
        "icon": "database",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "queryTimeoutMs",
        "title": "Query timeout (ms)",
        "description": "A query that runs longer than this is cancelled.",
        "type": "integer",
        "default": 30000,
        "minimum": 1000,
        "maximum": 600000
      },
      {
        "key": "maxRows",
        "title": "Max rows per query",
        "description": "Rows past this limit are dropped and the result is marked as truncated.",
        "type": "integer",
        "default": 500,
        "minimum": 1,
        "maximum": 5000
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "secrets:own" },
    { "kind": "settings:own" }
  ]
}
